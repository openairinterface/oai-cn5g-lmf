#---------------------------------------------------------------------
#
# Dockerfile for the OpenAirInterface LMF service
#   Valid for CentOS Stream 10
#
#---------------------------------------------------------------------

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------

FROM quay.io/centos/centos:stream10 AS oai-lmf-builder

ENV IS_DOCKERFILE=1

# meson and ninja-build come from CRB; libconfig-devel and libidn-devel come
# from EPEL. The other build_lmf dependencies are in BaseOS/AppStream.
RUN dnf config-manager --set-enabled crb && \
    dnf install epel-release -y && \
    dnf update -y && \
    # Log the exact OS release used for the build.
    cat /etc/os-release && \
    dnf install -y \
        psmisc \
        git \
        diffutils \
        libasan \
        wget \
        file \
        lapack-devel \
        openblas-devel && \
    # Libraries built from source are installed under /usr/local, which is not
    # on the default loader path on EL. This is also needed for the ldd check.
    echo "/usr/local/lib" > /etc/ld.so.conf.d/local-lib.conf && \
    echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local-lib.conf

# Git configuration
RUN git config --global https.postBuffer 123289600 && \
    git config --global http.sslverify false

# Copy source code
WORKDIR /openair-lmf
COPY . /openair-lmf

# Install and Build LMF
WORKDIR /openair-lmf/build/scripts
RUN ./build_lmf --install-deps --force
RUN ./build_lmf --clean --Verbose --build-type Release --jobs && \
    ldd /openair-lmf/build/lmf/build/lmf && \
    mv /openair-lmf/build/lmf/build/lmf /openair-lmf/build/lmf/build/oai_lmf

FROM mikefarah/yq:latest AS yq-source

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM quay.io/centos/centos:stream10-minimal AS oai-lmf
ENV TZ=Europe/Paris

# libconfig comes from EPEL; the other runtime packages are in BaseOS/AppStream.
RUN microdnf install -y epel-release && \
    microdnf update -y && \
    microdnf install -y \
# Timezone data, and debugging/networking utilities
      tzdata \
      procps-ng \
      psmisc \
      net-tools \
      iputils \
      tcpdump \
# Runtime dependencies of oai_lmf
      libicu \
      boost \
      libevent \
      nettle \
      gmp \
      libconfig \
      lapack \
      openblas \
      findutils && \
    microdnf clean all -y && \
    rm -rf /var/cache/yum /var/cache/dnf

# Copy executable and generated libraries
WORKDIR /openair-lmf/bin
COPY --from=oai-lmf-builder \
    /openair-lmf/build/lmf/build/oai_lmf \
    /openair-lmf/scripts/healthcheck.sh \
    ./
COPY --from=yq-source /usr/bin/yq /usr/bin

# Only the libraries built from source; the rest come from the packages above.
# pistache (meson) and nghttp2 (autotools) install into lib, the CMake-built
# spdlog, fmt, yaml-cpp and cpr into lib64.
COPY --from=oai-lmf-builder \
    /usr/local/lib/libpistache.so* \
    /usr/local/lib/libnghttp2_asio.so \
    /usr/local/lib/libnghttp2_asio.so.1 \
    /usr/local/lib64/libspdlog.so \
    /usr/local/lib64/libfmt.so \
    /usr/local/lib64/libyaml-cpp.so.0.* \
    /usr/local/lib64/libcpr.so.1* \
    /usr/lib64/

RUN ldconfig && \
    ldd /openair-lmf/bin/oai_lmf && \
    # ldd exits 0 even when a library is missing, so check its output
    ! ldd /openair-lmf/bin/oai_lmf | grep -q 'not found'

WORKDIR /openair-lmf/etc
COPY --from=oai-lmf-builder \
    /openair-lmf/etc/config.yaml ./

WORKDIR /openair-lmf

# Expose ports
EXPOSE 80/tcp

# Configure healthcheck
HEALTHCHECK --interval=10s \
            --timeout=15s \
            --retries=6 \
    CMD /openair-lmf/bin/healthcheck.sh

CMD ["/openair-lmf/bin/oai_lmf", "-c" , "/openair-lmf/etc/config.yaml", "-o"]
